        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Homework assignment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Activity": {
      "title": "Activity",
      "description": "System activity log record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
